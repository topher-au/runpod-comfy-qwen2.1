# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Anything exported in the shell, or passed as a flag, overrides these.

# Required: RunPod API key - https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# Serverless endpoint to release. Leave blank to auto-detect the endpoint whose
# template runs IMAGE (fails if the match is not unique).
RUNPOD_ENDPOINT_ID=

# Image built, pushed and released.
IMAGE=topherau/runpod-comfy-qwen2.1

# Optional ---------------------------------------------------------------

# RunPod REST base URL.
# RUNPOD_API=https://rest.runpod.io/v1

# Target platform for docker build (RunPod workers are linux/amd64).
# PLATFORM=linux/amd64

# Seconds to wait for the endpoint version to bump after the template update;
# 0 disables the wait. A scale-to-zero endpoint only bumps it once a request
# starts a worker, so a timeout here is a warning, not a failure.
# WAIT_TIMEOUT=180

# Set to skip the post-push registry visibility check (docker manifest inspect).
# SKIP_PUSH_CHECK=1

# Override the lock file used to keep two releases from overlapping.
# LOCK_FILE=/run/lock/runpod-comfy-qwen2.1.lock
